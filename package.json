{
  "name": "chat-builds-a-world",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20",
    "pnpm": ">=9"
  },
  "packageManager": "pnpm@9.10.0",
  "scripts": {
    "dev": "tsx watch server/index.ts",
    "demo:render": "node assets/blender/render.mjs",
    "sim": "tsx server/sim/index.ts",
    "sim:raid": "tsx server/sim/raid.ts",
    "check:raid": "tsx checks/phase8.raid.ts",
    "check": "tsx checks/generate-module-policy.ts --check && tsx checks/generate-validator.ts --check && tsc --noEmit && tsx --test checks/*.test.ts && tsx checks/build.ts && tsx checks/reactions.smoke.ts && tsx checks/history.smoke.ts",
    "summon:bench": "tsx server/summon/bench.ts",
    "guard:eval": "tsx server/guard/eval.ts",
    "runner:live": "tsx server/runner/live.ts",
    "runner:sim": "tsx checks/runner.sim.ts",
    "sim:soak": "tsx checks/perf-soak.ts",
    "check:gate": "tsx checks/candidate.smoke.ts",
    "sim:reactions": "tsx server/sim/reactions.ts",
    "check:reactions": "tsx checks/reactions.smoke.ts",
    "check:gate-load": "tsx checks/candidate-load.smoke.ts"
  },
  "dependencies": {
    "ajv": "^8.20.0",
    "dotenv": "^18.0.9",
    "three": "^0.187.0",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "20",
    "@types/three": "^0.187.0",
    "@types/ws": "^8.18.2",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "typescript-api": "npm:typescript@5.9.3"
  }
}
