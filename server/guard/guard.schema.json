{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "World idea guard decision",
  "type": "object",
  "additionalProperties": false,
  "required": ["verdict", "reason", "title", "spec", "files"],
  "properties": {
    "verdict": { "enum": ["accept", "reject"] },
    "reason": { "type": "string", "minLength": 1, "maxLength": 240 },
    "title": { "type": "string", "minLength": 1, "maxLength": 40 },
    "spec": {
      "anyOf": [
        { "type": "null" },
        {
          "type": "object", "additionalProperties": false,
          "required": ["moduleId", "description", "steps", "checks", "estimatedSeconds"],
          "properties": {
            "moduleId": { "type": "string", "pattern": "^[a-zA-Z][a-zA-Z0-9_-]{0,47}$" },
            "description": { "type": "string", "minLength": 1, "maxLength": 600 },
            "steps": { "type": "array", "minItems": 1, "maxItems": 4, "items": { "type": "string", "minLength": 1, "maxLength": 160 } },
            "checks": { "type": "array", "minItems": 1, "maxItems": 4, "items": { "type": "string", "minLength": 1, "maxLength": 160 } },
            "estimatedSeconds": { "type": "integer", "minimum": 1, "maximum": 119 }
          }
        }
      ]
    },
    "files": {
      "type": "array", "maxItems": 2,
      "items": { "type": "string", "maxLength": 240, "pattern": "^world/modules/(?:[a-zA-Z][a-zA-Z0-9_-]*/)*[a-zA-Z][a-zA-Z0-9_-]*\\.ts$" }
    }
  }
}
